{
  "name": "aequvg-backend",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "bun scripts/smoke.ts",
    "prisma:generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "db:seed": "bun prisma/seed.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.3.3",
    "@elysiajs/openapi": "^1.3.1",
    "@prisma/client": "^6.19.0",
    "elysia": "^1.4.16"
  },
  "devDependencies": {
    "@types/bun": "^1.3.1",
    "prisma": "^6.19.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
