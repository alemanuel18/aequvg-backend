generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext, pg_trgm]
}

enum InstitutionalBlockType {
  HERO
  CAMPO_LABORAL
  TESTIMONIO
  LABORATORIO
  PLAN_ESTUDIOS

  @@map("tipo_bloque_institucional")
}

enum AdministrativeUserStatus {
  ACTIVO
  INACTIVO
  BLOQUEADO

  @@map("estado_usuario_administrativo")
}

enum AdministrativeRegistrationStatus {
  PENDIENTE
  APROBADA
  RECHAZADA

  @@map("estado_solicitud_administrativa")
}

enum StudentAccountStatus {
  ACTIVO
  BLOQUEADO_TEMPORAL
  BLOQUEADO_PERMANENTE
  ELIMINADO

  @@map("estado_cuenta_estudiante")
}

enum AuthenticationProvider {
  PASSWORD
  MICROSOFT

  @@map("proveedor_autenticacion")
}

enum PublicationType {
  PAPER_DERIVADO_TESIS
  PROYECTO_INVESTIGACION

  @@map("tipo_publicacion_cientifica")
}

enum PublicationStatus {
  PENDIENTE_APROBACION
  APROBADO
  PUBLICADO
  RECHAZADO
  ARCHIVADO

  @@map("estado_publicacion_cientifica")
}

/// Destinos de comentarios habilitados en S4-COM. No incluye tesis, reacciones ni chat.
enum CommentTargetType {
  NOTICIA
  PROYECTO
  EVENTO

  @@map("tipo_destino_comentario")
}

enum CommentRevisionAction {
  EDIT
  DELETE

  @@map("accion_historial_comentario")
}

enum ContributionRole {
  AUTOR
  COAUTOR
  ASESOR
  COLABORADOR

  @@map("rol_contribucion")
}

enum ApprovalResponsibility {
  ASOCIACION
  FACULTAD
  DIRECCION

  @@map("responsabilidad_aprobacion")
}

enum ApprovalStatus {
  PENDIENTE
  APROBADO
  RECHAZADO

  @@map("estado_aprobacion")
}

enum ContentStatus {
  BORRADOR
  PUBLICADO
  ARCHIVADO

  @@map("estado_contenido")
}

enum EventStatus {
  BORRADOR
  PUBLICADO
  FINALIZADO
  CANCELADO
  ARCHIVADO

  @@map("estado_evento")
}

enum EventRegistrationStatus {
  CONFIRMADA
  CANCELADA

  @@map("estado_inscripcion_evento")
}

enum BoardMemberStatus {
  ACTIVO
  INACTIVO

  @@map("estado_miembro_junta")
}

enum ContactRequestStatus {
  PENDIENTE
  EN_PROCESO
  ATENDIDA
  ARCHIVADA

  @@map("estado_solicitud_contacto")
}

enum ContactRequestType {
  CONSULTA
  REUNION

  @@map("tipo_solicitud_contacto")
}

enum ContactMethodType {
  EMAIL
  TELEFONO
  UBICACION
  INSTAGRAM
  FACEBOOK
  OTRO

  @@map("tipo_medio_contacto")
}

model Role {
  id          Int     @id @default(autoincrement()) @map("id_rol")
  name        String  @unique @map("nombre") @db.VarChar(80)
  description String? @map("descripcion") @db.Text
  active      Boolean @default(true) @map("activo")

  permissions RolePermission[]
  users       AdministrativeUser[]

  @@map("rol")
}

model Permission {
  id          Int    @id @default(autoincrement()) @map("id_permiso")
  code        String @unique @map("codigo") @db.VarChar(120)
  description String @map("descripcion") @db.Text

  roles RolePermission[]

  @@map("permiso")
}

model RolePermission {
  roleId       Int @map("id_rol")
  permissionId Int @map("id_permiso")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("rol_permiso")
}

enum ProjectStatus {
  NO_APROBADO
  APROBADO
  EN_REVISION

  @@map("estado_proyecto")
}

enum ProjectType {
  TESIS
  PROYECTO

  @@map("tipo_proyecto")
}

model Project {
  id              Int           @id @default(autoincrement()) @map("id_proyecto")
  authorId        Int           @map("id_autor")
  reviewerId      Int?          @map("id_revisor")
  coverImageId    Int?          @map("id_imagen_portada")
  documentFileId  Int?          @map("id_documento")
  title           String        @map("titulo") @db.Citext
  slug            String        @unique @map("slug") @db.VarChar(220)
  description     String        @map("descripcion") @db.Text
  repositoryUrl   String?       @map("url_repositorio") @db.VarChar(2048)
  liveUrl         String?       @map("url_demo") @db.VarChar(2048)
  type            ProjectType   @map("tipo")
  status          ProjectStatus @default(EN_REVISION) @map("estado")
  rejectionReason String?       @map("motivo_rechazo") @db.Text
  reviewedAt      DateTime?     @map("revisado_en") @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @map("creado_en") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  // Relaciones
  author       AdministrativeUser  @relation("ProjectAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  reviewer     AdministrativeUser? @relation("ProjectReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  coverImage   File?               @relation("ProjectCoverImage", fields: [coverImageId], references: [id], onDelete: Restrict)
  documentFile File?               @relation("ProjectDocument", fields: [documentFileId], references: [id], onDelete: Restrict)
  comments     PublicationComment[]

  // Índices 
  @@index([status, createdAt])
  @@index([status, type, createdAt])
  @@index([authorId])
  @@index([reviewerId])
  @@index([coverImageId])
  @@index([documentFileId])
  @@map("proyecto")
}

model AdministrativeUser {
  id         Int                      @id @default(autoincrement()) @map("id_usuario")
  roleId     Int                      @map("id_rol")
  name       String                   @map("nombre") @db.VarChar(160)
  firstNames String                   @default("") @map("nombres") @db.VarChar(80)
  lastNames  String                   @default("") @map("apellidos") @db.VarChar(80)
  email      String                   @unique @map("correo") @db.Citext
  status     AdministrativeUserStatus @default(ACTIVO) @map("estado")
  createdAt  DateTime                 @default(now()) @map("creado_en") @db.Timestamptz(3)
  updatedAt  DateTime                 @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  role                         Role                                @relation(fields: [roleId], references: [id], onDelete: Restrict)
  credential                   AdministrativeCredential?
  identities                   AdministrativeIdentity[]
  sessions                     AdministrativeSession[]
  uploadedFiles                File[]
  createdPublications          ScientificPublication[]             @relation("PublicationCreator")
  publicationApprovals         PublicationApproval[]
  createdNews                  News[]
  createdEvents                Event[]
  createdResources             Resource[]
  assignedContactRequests      ContactRequest[]
  reviewedRegistrationRequests AdministrativeRegistrationRequest[] @relation("RegistrationReviewer")
  studentAccountActions       StudentAccountStatusHistory[]
  passwordResetRequests        AdministrativePasswordReset[]

  // Relaciones con proyectos
  createdProjects  Project[] @relation("ProjectAuthor")
  reviewedProjects Project[] @relation("ProjectReviewer")

  @@index([roleId, status])
  @@map("usuario_administrativo")
}

model AdministrativeRegistrationRequest {
  id           Int                              @id @default(autoincrement()) @map("id_solicitud")
  name         String                           @map("nombre") @db.VarChar(160)
  firstNames   String                           @default("") @map("nombres") @db.VarChar(80)
  lastNames    String                           @default("") @map("apellidos") @db.VarChar(80)
  email        String                           @map("correo") @db.Citext
  passwordHash String?                          @map("password_hash") @db.VarChar(255)
  status       AdministrativeRegistrationStatus @default(PENDIENTE) @map("estado")
  reviewedById Int?                             @map("id_revisor")
  reviewedAt   DateTime?                        @map("revisado_en") @db.Timestamptz(3)
  createdAt    DateTime                         @default(now()) @map("creado_en") @db.Timestamptz(3)
  reviewer     AdministrativeUser?              @relation("RegistrationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([email, status])
  @@map("solicitud_cuenta_administrativa")
}

model AdministrativePasswordReset {
  id        Int                @id @default(autoincrement()) @map("id_recuperacion")
  userId    Int                @map("id_usuario")
  tokenHash String             @unique @map("hash_token") @db.Char(64)
  expiresAt DateTime           @map("expira_en") @db.Timestamptz(3)
  usedAt    DateTime?          @map("usado_en") @db.Timestamptz(3)
  createdAt DateTime           @default(now()) @map("creado_en") @db.Timestamptz(3)
  user      AdministrativeUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt, expiresAt])
  @@index([expiresAt, usedAt])
  @@map("recuperacion_contrasena_administrativa")
}

model AdministrativeCredential {
  userId       Int      @id @map("id_usuario")
  passwordHash String   @map("password_hash") @db.VarChar(255)
  updatedAt    DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  user AdministrativeUser @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("credencial_administrativa")
}

model AdministrativeIdentity {
  id              Int                    @id @default(autoincrement()) @map("id_identidad")
  userId          Int                    @map("id_usuario")
  provider        AuthenticationProvider @map("proveedor")
  providerSubject String                 @map("sujeto_proveedor") @db.VarChar(255)
  createdAt       DateTime               @default(now()) @map("creado_en") @db.Timestamptz(3)
  updatedAt       DateTime               @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  user AdministrativeUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@unique([userId, provider])
  @@index([userId])
  @@map("identidad_administrativa")
}

model AdministrativeSession {
  id                  String    @id @default(uuid()) @map("id_sesion") @db.Uuid
  userId              Int       @map("id_usuario")
  tokenIdentifierHash String    @unique @map("hash_identificador_token") @db.Char(64)
  deviceSecretHash    String    @map("hash_secreto_dispositivo") @db.Char(64)
  browserContextHash  String    @map("hash_contexto_navegador") @db.Char(64)
  csrfTokenHash       String    @map("hash_token_csrf") @db.Char(64)
  expiresAt           DateTime  @map("expira_en") @db.Timestamptz(3)
  lastSeenAt          DateTime  @default(now()) @map("ultima_actividad_en") @db.Timestamptz(3)
  revokedAt           DateTime? @map("revocada_en") @db.Timestamptz(3)
  revocationReason    String?   @map("motivo_revocacion") @db.VarChar(80)
  createdAt           DateTime  @default(now()) @map("creada_en") @db.Timestamptz(3)

  user AdministrativeUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
  @@map("sesion_administrativa")
}

model StudentUser {
  id            Int                  @id @default(autoincrement()) @map("id_estudiante")
  name          String               @map("nombre") @db.VarChar(160)
  firstNames    String               @default("") @map("nombres") @db.VarChar(80)
  lastNames     String               @default("") @map("apellidos") @db.VarChar(80)
  email         String               @unique @map("correo") @db.Citext
  isStudent     Boolean              @default(true) @map("es_estudiante")
  status        StudentAccountStatus @default(ACTIVO) @map("estado")
  blockedUntil  DateTime?            @map("bloqueado_hasta") @db.Timestamptz(3)
  reviewChannel String?              @map("canal_revision") @db.VarChar(255)
  deletedAt     DateTime?            @map("eliminado_en") @db.Timestamptz(3)
  createdAt     DateTime             @default(now()) @map("creado_en") @db.Timestamptz(3)
  updatedAt     DateTime             @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  credential StudentCredential?
  sessions   StudentSession[]
  statusHistory StudentAccountStatusHistory[]
  eventRegistrations EventRegistration[]
  comments   PublicationComment[]
  commentRevisions PublicationCommentRevision[]

  @@index([status, blockedUntil])
  @@map("usuario_estudiante")
}

model StudentCredential {
  userId       Int      @id @map("id_estudiante")
  passwordHash String   @map("password_hash") @db.VarChar(255)
  updatedAt    DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  user StudentUser @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("credencial_estudiante")
}

model StudentSession {
  id                  String    @id @default(uuid()) @map("id_sesion") @db.Uuid
  userId              Int       @map("id_estudiante")
  tokenIdentifierHash String    @unique @map("hash_identificador_token") @db.Char(64)
  deviceSecretHash    String    @map("hash_secreto_dispositivo") @db.Char(64)
  browserContextHash  String    @map("hash_contexto_navegador") @db.Char(64)
  csrfTokenHash       String    @map("hash_token_csrf") @db.Char(64)
  expiresAt           DateTime  @map("expira_en") @db.Timestamptz(3)
  lastSeenAt          DateTime  @default(now()) @map("ultima_actividad_en") @db.Timestamptz(3)
  revokedAt           DateTime? @map("revocada_en") @db.Timestamptz(3)
  revocationReason    String?   @map("motivo_revocacion") @db.VarChar(80)
  createdAt           DateTime  @default(now()) @map("creada_en") @db.Timestamptz(3)

  user StudentUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
  @@map("sesion_estudiante")
}

model StudentAccountStatusHistory {
  id            Int                 @id @default(autoincrement()) @map("id_historial")
  studentId     Int                 @map("id_estudiante")
  actorId       Int?                @map("id_actor_administrativo")
  fromStatus    StudentAccountStatus @map("estado_anterior")
  toStatus      StudentAccountStatus @map("estado_nuevo")
  reason        String              @map("motivo") @db.Text
  blockedUntil  DateTime?            @map("bloqueado_hasta") @db.Timestamptz(3)
  reviewChannel String?             @map("canal_revision") @db.VarChar(255)
  createdAt     DateTime            @default(now()) @map("registrado_en") @db.Timestamptz(3)

  student StudentUser         @relation(fields: [studentId], references: [id], onDelete: Restrict)
  actor   AdministrativeUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([studentId, createdAt])
  @@index([actorId, createdAt])
  @@map("historial_estado_cuenta_estudiante")
}

model MicrosoftLoginChallenge {
  id           String    @id @default(uuid()) @map("id_desafio") @db.Uuid
  stateHash    String    @unique @map("hash_estado") @db.Char(64)
  verifierHash String    @map("hash_verificador") @db.Char(64)
  nonce        String    @map("nonce") @db.VarChar(128)
  returnTo     String?   @map("retorno_a") @db.VarChar(2048)
  expiresAt    DateTime  @map("expira_en") @db.Timestamptz(3)
  consumedAt   DateTime? @map("consumido_en") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)

  @@index([expiresAt, consumedAt])
  @@map("desafio_inicio_microsoft")
}

/// La primera migración debe agregar CHECK (tamano_bytes > 0).
model File {
  id           Int      @id @default(autoincrement()) @map("id_archivo")
  uploadedById Int      @map("cargado_por")
  originalName String   @map("nombre_original") @db.VarChar(255)
  storageKey   String   @unique @map("clave_almacenamiento") @db.VarChar(512)
  mimeType     String   @map("tipo_mime") @db.VarChar(150)
  sizeBytes    BigInt   @map("tamano_bytes")
  sha256       String   @map("checksum_sha256") @db.Char(64)
  createdAt    DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  uploadedBy   AdministrativeUser      @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  publications ScientificPublication[] @relation("PublicationFile")
  newsImages   News[]                  @relation("NewsImage")
  eventImages  Event[]                 @relation("EventImage")
  resources    Resource[]              @relation("ResourceFile")
  boardPhotos  BoardMember[]           @relation("BoardPhoto")

  //Relacion con proyecto
  projectCovers    Project[] @relation("ProjectCoverImage")
  projectDocuments Project[] @relation("ProjectDocument")

  @@index([uploadedById])
  @@index([sha256])
  @@map("archivo")
}

model ScientificPublication {
  id                    Int               @id @default(autoincrement()) @map("id_publicacion")
  createdById           Int               @map("creado_por")
  fileId                Int?              @map("id_archivo")
  originalPublicationId Int?              @map("id_publicacion_original")
  title                 String            @map("titulo") @db.Citext
  type                  PublicationType   @map("tipo")
  abstract              String            @map("resumen") @db.Text
  researchArea          String            @map("area_investigacion") @db.VarChar(180)
  keywords              String[]          @default([]) @map("palabras_clave")
  publicationYear       Int               @map("anio_publicacion") @db.SmallInt
  bibliographicData     String?           @map("datos_bibliograficos") @db.Text
  externalUrl           String?           @map("enlace_externo") @db.VarChar(2048)
  status                PublicationStatus @default(PENDIENTE_APROBACION) @map("estado")
  registeredAt          DateTime          @default(now()) @map("registrado_en") @db.Timestamptz(3)
  publishedAt           DateTime?         @map("publicado_en") @db.Timestamptz(3)

  createdBy           AdministrativeUser       @relation("PublicationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  file                File?                    @relation("PublicationFile", fields: [fileId], references: [id], onDelete: Restrict)
  originalPublication ScientificPublication?   @relation("PublicationExtensions", fields: [originalPublicationId], references: [id], onDelete: Restrict)
  extensions          ScientificPublication[]  @relation("PublicationExtensions")
  contributors        PublicationContributor[]
  approvals           PublicationApproval[]

  @@index([status, type, publicationYear])
  @@index([title])
  @@index([createdById])
  @@index([fileId])
  @@index([originalPublicationId])
  @@map("publicacion_cientifica")
}

model AuthorPerson {
  id   Int    @id @default(autoincrement()) @map("id_persona")
  name String @map("nombre") @db.VarChar(160)

  publications PublicationContributor[]

  @@index([name])
  @@map("persona_autora")
}

/// La primera migración debe agregar CHECK (orden_autoria > 0).
model PublicationContributor {
  publicationId    Int              @map("id_publicacion")
  personId         Int              @map("id_persona")
  contributionRole ContributionRole @default(AUTOR) @map("rol_contribucion")
  authorOrder      Int              @map("orden_autoria") @db.SmallInt

  publication ScientificPublication @relation(fields: [publicationId], references: [id], onDelete: Restrict)
  person      AuthorPerson          @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@id([publicationId, personId])
  @@unique([publicationId, authorOrder])
  @@index([personId])
  @@map("publicacion_contribuyente")
}

model PublicationApproval {
  id             Int                    @id @default(autoincrement()) @map("id_aprobacion")
  publicationId  Int                    @map("id_publicacion")
  userId         Int                    @map("id_usuario")
  responsibility ApprovalResponsibility @map("responsabilidad")
  status         ApprovalStatus         @default(PENDIENTE) @map("estado")
  observations   String?                @map("observaciones") @db.Text
  registeredAt   DateTime               @default(now()) @map("registrada_en") @db.Timestamptz(3)

  publication ScientificPublication @relation(fields: [publicationId], references: [id], onDelete: Restrict)
  user        AdministrativeUser    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([publicationId, userId])
  @@index([publicationId, status])
  @@index([userId])
  @@map("aprobacion_publicacion")
}

model NewsCategory {
  id        Int      @id @default(autoincrement()) @map("id_categoria_noticia")
  name      String   @unique @map("nombre") @db.Citext
  active    Boolean  @default(true) @map("activa")
  createdAt DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  news News[]

  @@index([active, name])
  @@map("categoria_noticia")
}

model News {
  id          Int           @id @default(autoincrement()) @map("id_noticia")
  createdById Int           @map("creado_por")
  categoryId  Int           @map("id_categoria_noticia")
  imageId     Int?          @map("id_imagen")
  title       String        @map("titulo") @db.VarChar(220)
  summary     String        @map("resumen") @db.Text
  content     String        @map("contenido") @db.Text
  status      ContentStatus @default(BORRADOR) @map("estado")
  createdAt   DateTime      @default(now()) @map("creado_en") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("actualizado_en") @db.Timestamptz(3)
  publishedAt DateTime?     @map("publicado_en") @db.Timestamptz(3)

  createdBy     AdministrativeUser @relation(fields: [createdById], references: [id], onDelete: Restrict)
  category      NewsCategory       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  image         File?              @relation("NewsImage", fields: [imageId], references: [id], onDelete: Restrict)
  featuredItems FeaturedItem[]
  comments      PublicationComment[]

  @@index([status, publishedAt])
  @@index([categoryId, status, publishedAt])
  @@index([createdById])
  @@index([imageId])
  @@map("noticia")
}

/// La primera migración debe agregar CHECK (capacidad_maxima > 0).
model Event {
  id                    Int         @id @default(autoincrement()) @map("id_evento")
  createdById           Int         @map("creado_por")
  imageId               Int?        @map("id_imagen")
  name                  String      @map("nombre") @db.VarChar(220)
  description           String      @map("descripcion") @db.Text
  startsAt              DateTime    @map("inicia_en") @db.Timestamptz(3)
  location              String      @map("ubicacion") @db.VarChar(255)
  maximumCapacity       Int         @map("capacidad_maxima")
  additionalInformation String?     @map("informacion_adicional") @db.Text
  status                EventStatus @default(BORRADOR) @map("estado")
  createdAt             DateTime    @default(now()) @map("creado_en") @db.Timestamptz(3)

  createdBy     AdministrativeUser  @relation(fields: [createdById], references: [id], onDelete: Restrict)
  image         File?               @relation("EventImage", fields: [imageId], references: [id], onDelete: Restrict)
  registrations EventRegistration[]
  featuredItems FeaturedItem[]
  comments      PublicationComment[]

  @@index([status, startsAt])
  @@index([createdById])
  @@index([imageId])
  @@map("evento")
}

model EventRegistration {
  id             Int                     @id @default(autoincrement()) @map("id_inscripcion")
  eventId        Int                     @map("id_evento")
  studentId      Int?                    @map("id_estudiante")
  fullName       String                  @map("nombre_completo") @db.VarChar(160)
  firstNames     String                  @default("") @map("nombres") @db.VarChar(80)
  lastNames      String                  @default("") @map("apellidos") @db.VarChar(80)
  email          String                  @map("correo") @db.Citext
  phone          String                  @map("telefono") @db.VarChar(40)
  status         EventRegistrationStatus @default(CONFIRMADA) @map("estado")
  consentedAt    DateTime                @map("consentimiento_en") @db.Timestamptz(3)
  privacyVersion String                  @map("version_privacidad") @db.VarChar(40)
  registeredAt   DateTime                @default(now()) @map("inscrito_en") @db.Timestamptz(3)

  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)
  student StudentUser? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@unique([eventId, email])
  @@index([eventId, status])
  @@index([studentId, registeredAt, id])
  @@map("inscripcion_evento")
}

model ResourceCategory {
  id        Int      @id @default(autoincrement()) @map("id_categoria_recurso")
  name      String   @unique @map("nombre") @db.Citext
  active    Boolean  @default(true) @map("activa")
  createdAt DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  resources Resource[]

  @@index([active, name])
  @@map("categoria_recurso")
}

model Resource {
  id          Int           @id @default(autoincrement()) @map("id_recurso")
  createdById Int           @map("creado_por")
  categoryId  Int           @map("id_categoria_recurso")
  fileId      Int?          @map("id_archivo")
  title       String        @map("titulo") @db.VarChar(220)
  description String        @map("descripcion") @db.Text
  status      ContentStatus @default(BORRADOR) @map("estado")
  createdAt   DateTime      @default(now()) @map("creado_en") @db.Timestamptz(3)
  publishedAt DateTime?     @map("publicado_en") @db.Timestamptz(3)

  createdBy AdministrativeUser @relation(fields: [createdById], references: [id], onDelete: Restrict)
  category  ResourceCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  file      File?              @relation("ResourceFile", fields: [fileId], references: [id], onDelete: Restrict)
  links     ResourceLink[]

  @@index([status, publishedAt])
  @@index([categoryId, status, publishedAt])
  @@index([createdById])
  @@index([fileId])
  @@map("recurso")
}

model ResourceLink {
  id           Int      @id @default(autoincrement()) @map("id_enlace_recurso")
  resourceId   Int      @map("id_recurso")
  label        String   @map("etiqueta") @db.VarChar(160)
  url          String   @map("url") @db.VarChar(2048)
  displayOrder Int      @default(0) @map("orden")
  createdAt    DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([resourceId, url])
  @@index([resourceId, displayOrder])
  @@map("enlace_recurso")
}

model BoardMember {
  id                 Int               @id @default(autoincrement()) @map("id_miembro")
  photoId            Int?              @map("id_fotografia")
  name               String            @map("nombre") @db.VarChar(160)
  firstNames         String            @default("") @map("nombres") @db.VarChar(80)
  lastNames          String            @default("") @map("apellidos") @db.VarChar(80)
  position           String            @map("cargo") @db.VarChar(120)
  description        String?           @map("descripcion") @db.Text
  institutionalEmail String            @map("correo_institucional") @db.Citext
  term               String            @map("periodo") @db.VarChar(80)
  termStartsAt       DateTime?         @map("periodo_inicio") @db.Date
  termEndsAt         DateTime?         @map("periodo_fin") @db.Date
  displayOrder       Int               @default(0) @map("orden")
  status             BoardMemberStatus @default(ACTIVO) @map("estado")

  photo File? @relation("BoardPhoto", fields: [photoId], references: [id], onDelete: Restrict)

  @@index([status, displayOrder])
  @@index([termStartsAt, termEndsAt])
  @@index([photoId])
  @@map("miembro_junta")
}

model ContactRequest {
  id             Int                  @id @default(autoincrement()) @map("id_solicitud")
  assignedToId   Int?                 @map("atendido_por")
  name           String               @map("nombre") @db.VarChar(160)
  firstNames     String               @default("") @map("nombres") @db.VarChar(80)
  lastNames      String               @default("") @map("apellidos") @db.VarChar(80)
  email          String               @map("correo") @db.Citext
  phone          String               @map("telefono") @db.VarChar(40)
  type           ContactRequestType   @default(CONSULTA) @map("tipo")
  subject        String               @map("asunto") @db.VarChar(220)
  message        String               @map("mensaje") @db.Text
  preferredAt    DateTime?            @map("fecha_preferida") @db.Timestamptz(3)
  status         ContactRequestStatus @default(PENDIENTE) @map("estado_atencion")
  consentedAt    DateTime             @map("consentimiento_en") @db.Timestamptz(3)
  privacyVersion String               @map("version_privacidad") @db.VarChar(40)
  sentAt         DateTime             @default(now()) @map("enviado_en") @db.Timestamptz(3)

  assignedTo AdministrativeUser? @relation(fields: [assignedToId], references: [id], onDelete: Restrict)

  @@index([status, sentAt])
  @@index([assignedToId])
  @@map("solicitud_contacto")
}

model InstitutionalBlock {
  id           Int                    @id @default(autoincrement()) @map("id_bloque")
  type         InstitutionalBlockType @map("tipo")
  title        String                 @map("titulo") @db.VarChar(220)
  subtitle     String?                @map("subtitulo") @db.VarChar(320)
  body         String                 @map("contenido") @db.Text
  imageUrl     String?                @map("imagen_url") @db.VarChar(2048)
  actionLabel  String?                @map("accion_texto") @db.VarChar(100)
  actionUrl    String?                @map("accion_url") @db.VarChar(2048)
  displayOrder Int                    @default(0) @map("orden")
  status       ContentStatus          @default(BORRADOR) @map("estado")
  createdAt    DateTime               @default(now()) @map("creado_en") @db.Timestamptz(3)
  updatedAt    DateTime               @updatedAt @map("actualizado_en") @db.Timestamptz(3)
  publishedAt  DateTime?              @map("publicado_en") @db.Timestamptz(3)

  @@index([status, type, displayOrder])
  @@map("bloque_institucional")
}

model FeaturedItem {
  id           Int      @id @default(autoincrement()) @map("id_destacado")
  newsId       Int?     @map("id_noticia")
  eventId      Int?     @map("id_evento")
  displayOrder Int      @default(0) @map("orden")
  createdAt    DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  news  News?  @relation(fields: [newsId], references: [id], onDelete: Cascade)
  event Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([newsId])
  @@unique([eventId])
  @@index([displayOrder])
  @@map("destacado_inicio")
}

model ContactMethod {
  id           Int               @id @default(autoincrement()) @map("id_medio")
  type         ContactMethodType @map("tipo")
  label        String            @map("etiqueta") @db.VarChar(100)
  value        String            @map("valor") @db.VarChar(320)
  url          String?           @map("url") @db.VarChar(2048)
  displayOrder Int               @default(0) @map("orden")
  active       Boolean           @default(true) @map("activo")
  createdAt    DateTime          @default(now()) @map("creado_en") @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  @@index([active, displayOrder])
  @@map("medio_contacto")
}

/// Comentario de texto plano vinculado a exactamente una noticia, proyecto o evento.
/// La migración aplica CHECK para que el FK no nulo coincida con targetType.
/// studentId se vuelve null al anonimizar una cuenta; deletedAt representa retiro lógico.
model PublicationComment {
  id          Int               @id @default(autoincrement()) @map("id_comentario")
  studentId   Int?              @map("id_estudiante")
  targetType  CommentTargetType @map("tipo_destino")
  newsId      Int?              @map("id_noticia")
  projectId   Int?              @map("id_proyecto")
  eventId     Int?              @map("id_evento")
  content     String            @map("contenido") @db.VarChar(2000)
  dedupeHash  String            @unique(map: "comentario_publicacion_no_duplicado_idx") @map("hash_deduplicacion") @db.Char(64)
  createdAt   DateTime          @default(now()) @map("creado_en") @db.Timestamptz(3)
  deletedAt   DateTime?         @map("eliminado_en") @db.Timestamptz(3)

  student StudentUser? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  news    News?        @relation(fields: [newsId], references: [id], onDelete: Cascade)
  project Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  event   Event?        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  revisions PublicationCommentRevision[]

  @@index([targetType, newsId, createdAt], map: "comentario_publicacion_noticia_fecha_idx")
  @@index([targetType, projectId, createdAt], map: "comentario_publicacion_proyecto_fecha_idx")
  @@index([targetType, eventId, createdAt], map: "comentario_publicacion_evento_fecha_idx")
  @@index([studentId, createdAt], map: "comentario_publicacion_estudiante_fecha_idx")
  @@map("comentario_publicacion")
}

/// Auditoría privada de edición y retiro; actorStudentId puede quedar null al anonimizar.
model PublicationCommentRevision {
  id                Int                   @id @default(autoincrement()) @map("id_historial_comentario")
  commentId         Int                   @map("id_comentario")
  actorStudentId    Int?                  @map("id_estudiante_actor")
  action            CommentRevisionAction @map("accion")
  previousContent   String                @map("contenido_anterior") @db.VarChar(2000)
  nextContent       String?               @map("contenido_nuevo") @db.VarChar(2000)
  changedAt         DateTime              @default(now()) @map("cambiado_en") @db.Timestamptz(3)

  comment PublicationComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  actor   StudentUser?       @relation(fields: [actorStudentId], references: [id], onDelete: SetNull)

  @@index([changedAt, id])
  @@index([commentId, changedAt])
  @@map("historial_comentario_publicacion")
}
