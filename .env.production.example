COMPOSE_PROJECT_NAME=aequvg-backend-prod
POSTGRES_DB=aequvg
POSTGRES_USER=replace-me
POSTGRES_PASSWORD=replace-with-a-strong-password
BACKEND_PORT=3000
CORS_ORIGIN=https://example.org
FRONTEND_URL=https://example.org
SESSION_SECRET=replace-with-at-least-32-random-characters
# Leave empty until the Association has ratified and versioned the moderation policy.
# An empty value keeps detection/rejection active but disables progressive sanctions.
# Configuration and moderator operations: docs/moderation-operations.md
# The validator checks metadata fields; approval authority must be verified operationally.
MODERATION_POLICY_JSON=
COOKIE_SECURE=true
SEED_ADMIN_PASSWORD=replace-only-when-running-the-manual-seed
MICROSOFT_TENANT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_CLIENT_SECRET=replace-with-entra-client-secret
MICROSOFT_REDIRECT_URI=https://api.example.org/api/v1/auth/microsoft/callback
RESEND_API_KEY=replace-with-resend-api-key
CONTACT_FROM_EMAIL="AsoQuimica UVG <contacto@example.org>"
LOG_LEVEL=info
LOG_HEALTHCHECKS=false
