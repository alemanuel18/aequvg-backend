# Nombre aislado para los recursos creados por Docker Compose.
COMPOSE_PROJECT_NAME=aequvg-backend

# PostgreSQL 16 (servicio `db`).
POSTGRES_DB=aequvg
POSTGRES_USER=aequvg
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# API Elysia: el puerto interno del contenedor siempre es 3000.
BACKEND_PORT=3000
CORS_ORIGIN=http://localhost:3001
FRONTEND_URL=http://localhost:3001
DATABASE_URL=postgresql://aequvg:change-me@db:5432/aequvg

# JWT, cookies y cuenta administrativa local de desarrollo.
SESSION_SECRET=change-me-with-at-least-32-random-characters
COOKIE_SECURE=false
SEED_ADMIN_PASSWORD=Change-this-development-password-123!

# Aplicación registrada en Microsoft Entra ID. No usar "common": se exige el tenant UVG.
MICROSOFT_TENANT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_CLIENT_SECRET=replace-with-development-secret
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/v1/auth/microsoft/callback

# Logs de desarrollo. No se registran cuerpos, tokens ni datos personales.
LOG_LEVEL=debug
LOG_FORMAT=pretty
LOG_HEALTHCHECKS=false
